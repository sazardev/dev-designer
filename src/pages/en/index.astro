---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
import { useTranslations } from "../../i18n/ui";
import type { Locale } from "../../i18n/ui";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead description={t["site.description"]} title={SITE_TITLE} />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <div class="hero">
        <h1 class="hero-title">{t["site.title"]}</h1>
        <p class="hero-description">{t["site.description"]}</p>
        <a class="hero-link" href={`/${locale}/blog`}>{t["nav.blog"]}</a>
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .hero {
    padding: var(--space-4xl) 0;
  }
  .hero-title {
    margin: 0 0 var(--space-md) 0;
    font-family: var(--font-display);
    font-size: var(--display-lg);
    letter-spacing: var(--ls-display-lg);
    line-height: var(--lh-display);
  }
  .hero-description {
    margin: 0 0 var(--space-xl) 0;
    color: var(--text-secondary);
    font-size: var(--body);
    max-width: 480px;
  }
  .hero-link {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--label);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    text-decoration: none;
    color: var(--black);
    background: var(--text-display);
    border-radius: 4px;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .hero-link:hover {
    opacity: 0.8;
    color: var(--black);
  }
</style>
