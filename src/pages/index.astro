---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, DEFAULT_LOCALE } from "../consts";
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <BaseHead description={SITE_DESCRIPTION[DEFAULT_LOCALE]} title={SITE_TITLE} />
  </head>
  <body>
    <Header locale={DEFAULT_LOCALE} />
    <main>
      <h1>Bienvenido a dev-design</h1>
      <p>Redirigiendo al blog...</p>
    </main>
    <Footer locale={DEFAULT_LOCALE} />
    <script>
      window.location.href = "/es/blog";
    </script>
  </body>
</html>
