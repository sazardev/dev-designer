---
import { useTranslations } from "../i18n/ui";
import type { Locale } from "../i18n/ui";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<PagefindConfig instance="blog-search" lang={locale} preload={true} />

<div class="search-overlay is-hidden" id="search-overlay">
  <div class="search-dialog">
    <div class="search-header">
      <svg
        class="search-icon"
        fill="none"
        height="16"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
      </svg>
      <div class="search-input-wrap">
        <pagefind-input instance="blog-search" placeholder={t["blog.search"]}></pagefind-input>
      </div>
      <button aria-label="Close search" class="close-btn" id="close-search">
        <span class="kbd">ESC</span>
      </button>
    </div>
    <div class="search-body">
      <pagefind-results instance="blog-search"></pagefind-results>
    </div>
    <div class="search-footer">
      <span class="footer-hint"><span class="kbd">↑↓</span> navegar</span>
      <span class="footer-hint"><span class="kbd">↵</span> abrir</span>
      <span class="footer-hint"><span class="kbd">esc</span> cerrar</span>
    </div>
  </div>
</div>

<script>
  function openSearch() {
    const overlay = document.getElementById("search-overlay");
    if (overlay) {
      overlay.classList.remove("is-hidden");
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        const input = overlay.querySelector("input") as HTMLInputElement;
        if (input) input.focus();
      }, 50);
    }
  }

  function closeSearch() {
    const overlay = document.getElementById("search-overlay");
    if (overlay) {
      overlay.classList.add("is-hidden");
      document.body.style.overflow = "";
    }
  }

  (window as unknown as { openSearch: () => void }).openSearch = openSearch;

  document.getElementById("close-search")?.addEventListener("click", closeSearch);
  document.getElementById("search-overlay")?.addEventListener("click", (e) => {
    if (e.target === e.currentTarget) closeSearch();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openSearch();
    }
  });
</script>

<style>
  /* ========================================
     OVERRIDE PAGEFIND DEFAULT STYLES
     ======================================== */

  /* Hide the searchbox dropdown (we don't use pagefind-searchbox) */
  :global(.pf-searchbox-dropdown),
  :global(.pf-searchbox) {
    all: unset !important;
    display: contents !important;
  }

  /* pagefind-input: strip all default styling */
  :global(pagefind-input) {
    all: unset !important;
    display: block !important;
    flex: 1 !important;
    min-width: 0 !important;
  }

  :global(pagefind-input input) {
    width: 100% !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    font-family: var(--font-mono) !important;
    font-size: var(--body) !important;
    color: var(--text-display) !important;
    padding: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    caret-color: var(--text-display) !important;
  }

  :global(pagefind-input input::placeholder) {
    color: var(--text-disabled) !important;
    font-family: var(--font-mono) !important;
    font-size: var(--body-sm) !important;
    text-transform: uppercase !important;
    letter-spacing: var(--ls-caption) !important;
  }

  :global(pagefind-input input:focus) {
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  /* pagefind-results: strip all default styling */
  :global(pagefind-results) {
    all: unset !important;
    display: block !important;
    overflow-y: auto !important;
    flex: 1 !important;
    min-height: 0 !important;
  }

  :global(.pf-results) {
    all: unset !important;
    display: block !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  :global(.pf-results li) {
    all: unset !important;
    display: block !important;
  }

  :global(.pf-result) {
    display: block !important;
    padding: var(--space-md) var(--space-lg) !important;
    border-bottom: 1px solid var(--border) !important;
    cursor: pointer !important;
    text-decoration: none !important;
    transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1) !important;
  }

  :global(.pf-result:last-child) {
    border-bottom: none !important;
  }

  :global(.pf-result:hover),
  :global(.pf-result[data-selected="true"]) {
    background: var(--surface-raised) !important;
  }

  :global(.pf-result-title) {
    display: block !important;
    font-family: var(--font-body) !important;
    font-size: var(--body) !important;
    font-weight: 500 !important;
    color: var(--text-display) !important;
    margin-bottom: var(--space-2xs) !important;
  }

  :global(.pf-result-excerpt) {
    display: block !important;
    font-family: var(--font-body) !important;
    font-size: var(--body-sm) !important;
    color: var(--text-secondary) !important;
    line-height: 1.5 !important;
  }

  :global(.pf-result-excerpt mark),
  :global(.pf-result mark) {
    background: var(--accent-subtle) !important;
    color: var(--text-display) !important;
    border-radius: 2px !important;
    padding: 0 2px !important;
  }

  :global(.pf-summary) {
    display: none !important;
  }

  :global(.pf-empty),
  :global(.pf-loading) {
    display: block !important;
    padding: var(--space-3xl) var(--space-lg) !important;
    text-align: center !important;
    font-family: var(--font-mono) !important;
    font-size: var(--label) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    color: var(--text-secondary) !important;
  }

  /* ========================================
     OVERLAY
     ======================================== */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    background: rgba(0, 0, 0, 0.85);
  }
  .search-overlay.is-hidden {
    display: none;
  }

  /* ========================================
     DIALOG
     ======================================== */
  .search-dialog {
    width: 92%;
    max-width: 560px;
    max-height: 64vh;
    background: var(--surface);
    border: 1px solid var(--border-visible);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ========================================
     HEADER
     ======================================== */
  .search-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border);
  }

  .search-icon {
    flex-shrink: 0;
    color: var(--text-disabled);
    width: 16px;
    height: 16px;
  }

  .search-input-wrap {
    flex: 1;
    min-width: 0;
  }

  .close-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    background: var(--surface-raised);
    border: 1px solid var(--border-visible);
    border-radius: 4px;
  }

  /* ========================================
     BODY
     ======================================== */
  .search-body {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  .search-body::-webkit-scrollbar {
    width: 4px;
  }
  .search-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .search-body::-webkit-scrollbar-thumb {
    background: var(--border-visible);
    border-radius: 2px;
  }

  /* ========================================
     FOOTER
     ======================================== */
  .search-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-sm) var(--space-lg);
    border-top: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .footer-hint {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--ls-caption);
    color: var(--text-disabled);
  }
</style>
