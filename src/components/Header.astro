---
import HeaderLink from "./HeaderLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "../consts";
import { useTranslations } from "../i18n/ui";
import type { Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header>
  <nav>
    <a class="site-title" href={`/${locale}/`}>{SITE_TITLE}</a>
    <div class="nav-links">
      <HeaderLink href={`/${locale}/`}>{t["nav.home"]}</HeaderLink>
      <HeaderLink href={`/${locale}/blog`}>{t["nav.blog"]}</HeaderLink>
      <HeaderLink href={`/${locale}/about`}>{t["nav.about"]}</HeaderLink>
    </div>
    <div class="header-actions">
      <button class="search-btn" id="header-search-btn" title={t["blog.search"]}>
        <svg
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" x2="16.65" y1="21" y2="16.65"></line>
        </svg>
      </button>
      <LanguageSwitcher locale={locale} />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  document.getElementById("header-search-btn")?.addEventListener("click", () => {
    (window as unknown as { openSearch?: () => void }).openSearch?.();
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: var(--black);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
  }
  .site-title {
    font-family: var(--font-mono);
    font-size: var(--body-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    text-decoration: none;
    color: var(--text-display);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-visible);
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
    color: var(--text-secondary);
    transition: all var(--duration-fast) var(--ease-out);
  }
  .search-btn:hover {
    border-color: var(--text-secondary);
    color: var(--text-primary);
  }
  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
    nav {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
