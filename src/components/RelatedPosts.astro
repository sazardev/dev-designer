---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CategoryBadge from "./CategoryBadge.astro";
import DifficultyBadge from "./DifficultyBadge.astro";

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  difficulty?: string;
  heroImage?: ImageMetadata;
  author: string;
}

interface Props {
  posts: RelatedPost[];
  locale: string;
}

const { posts, locale } = Astro.props;
---

{
  posts.length > 0 && (
    <div class="related-section">
      <h3 class="related-title">ARTICULOS RELACIONADOS</h3>
      <div class="related-grid">
        {posts.map((post) => (
          <a class="related-card" href={`/${locale}/blog/${post.slug}/`}>
            {post.heroImage && (
              <div class="related-image">
                <Image alt="" height={180} src={post.heroImage} width={320} />
              </div>
            )}
            <div class="related-content">
              <div class="related-meta">
                <CategoryBadge category={post.category} locale={locale} />
                {post.difficulty && (
                  <DifficultyBadge difficulty={post.difficulty} locale={locale} />
                )}
              </div>
              <h4>{post.title}</h4>
              <p>{post.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .related-section {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border);
  }
  .related-title {
    font-family: var(--font-mono);
    font-size: var(--label);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }
  .related-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .related-card:hover {
    border-color: var(--border-visible);
  }
  .related-image :global(img) {
    width: 100%;
    height: 140px;
    object-fit: cover;
    display: block;
  }
  .related-content {
    padding: var(--space-md);
  }
  .related-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }
  .related-card h4 {
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--body-sm);
    font-weight: 500;
    color: var(--text-display);
    line-height: var(--lh-heading);
  }
  .related-card p {
    margin: 0;
    font-size: var(--caption);
    color: var(--text-secondary);
    line-height: var(--lh-body);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
