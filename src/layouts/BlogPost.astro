---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import FormattedDate from "../components/FormattedDate.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import DifficultyBadge from "../components/DifficultyBadge.astro";
import TagList from "../components/TagList.astro";
import TableOfContents from "../components/TableOfContents.astro";
import AuthorCard from "../components/AuthorCard.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { useTranslations } from "../i18n/ui";
import type { Locale } from "../i18n/ui";

type Props = CollectionEntry<"blog">["data"] & {
  locale: Locale;
  readingTime?: string;
  headings?: { depth: number; slug: string; text: string }[];
  slug?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author,
  tags,
  category,
  difficulty,
  locale,
  readingTime,
  headings = [],
  slug,
} = Astro.props;
const t = useTranslations(locale);

// Get related posts
let relatedPostsData: CollectionEntry<"blog">[] = [];
if (slug) {
  const allPosts = await getCollection("blog");
  relatedPostsData = allPosts
    .filter(
      (p) => p.data.locale === locale && !p.data.draft && p.id.replace(`${locale}/`, "") !== slug,
    )
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
}

const relatedMapped = relatedPostsData.map((p) => ({
  slug: p.id.replace(`${locale}/`, ""),
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  category: p.data.category,
  difficulty: p.data.difficulty,
  heroImage: p.data.heroImage,
  author: p.data.author,
}));
---

<html lang={locale}>
  <head>
    <BaseHead description={description} title={title} />
  </head>

  <body>
    <ReadingProgress />
    <Header locale={locale} />
    <main>
      <article>
        {
          heroImage && (
            <div class="hero-image" transition:name={`hero-${slug}`}>
              <Image alt="" height={510} src={heroImage} width={1020} />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            <div class="meta-bar">
              <CategoryBadge category={category} locale={locale} />
              {difficulty && <DifficultyBadge difficulty={difficulty} locale={locale} />}
              {readingTime && <span class="reading-time">{readingTime}</span>}
            </div>
            <h1 transition:name={`title-${slug}`}>{title}</h1>
            <div class="date-line">
              <FormattedDate date={pubDate} />
              {
                author && (
                  <>
                    <span class="date-separator">·</span>
                    <span class="author">{author}</span>
                  </>
                )
              }
              {
                updatedDate && (
                  <>
                    <span class="date-separator">·</span>
                    <span class="updated">
                      {t["blog.updated"]} <FormattedDate date={updatedDate} />
                    </span>
                  </>
                )
              }
            </div>
          </div>

          <TableOfContents headings={headings} />

          <slot />

          {
            tags.length > 0 && (
              <div class="tags-section">
                <TagList locale={locale} tags={tags} />
              </div>
            )
          }

          <AuthorCard author={author} locale={locale} />

          <RelatedPosts locale={locale} posts={relatedMapped} />
        </div>
      </article>
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .hero-image {
    margin-bottom: var(--space-xl);
  }
  .hero-image :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .prose {
    width: 720px;
    max-width: calc(100% - var(--space-xl));
    margin: 0 auto;
  }
  .title {
    margin-bottom: var(--space-2xl);
  }
  .meta-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }
  .reading-time {
    font-family: var(--font-mono);
    font-size: var(--label);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--text-disabled);
  }
  .title h1 {
    margin: 0 0 var(--space-md) 0;
    font-size: var(--display-md);
    letter-spacing: var(--ls-display-md);
    line-height: var(--lh-display);
  }
  .date-line {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--caption);
    text-transform: uppercase;
    letter-spacing: var(--ls-caption);
    color: var(--text-secondary);
  }
  .date-separator {
    opacity: 0.4;
  }
  .author {
    color: var(--text-primary);
  }
  .updated {
    color: var(--text-disabled);
    font-style: italic;
    text-transform: none;
  }
  .tags-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }
</style>
