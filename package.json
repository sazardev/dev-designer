{
  "name": "dev-designer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,jsx,mdx,json,md,css,yml,yaml}\" \"*.{json,js,mjs,cjs}\" \".prettierrc.mjs\" \"eslint.config.js\" \"commitlint.config.js\" \"knip.json\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,jsx,mdx,json,md,css,yml,yaml}\" \"*.{json,js,mjs,cjs}\" \".prettierrc.mjs\" \"eslint.config.js\" \"commitlint.config.js\" \"knip.json\"",
    "check": "astro check",
    "knip": "knip",
    "check:links": "node scripts/check-links.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:routes-bash": "bash scripts/check-routes.sh",
    "check:all": "bash scripts/check-links.sh && bash scripts/check-routes.sh",
    "audit": "npm run check && npm run lint && npm run format:check && npm run knip && npm run check:routes && npm run build && npm run check:links && npm run check:all",
    "fix": "npm run lint:fix && npm run format"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,jsx,mdx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.4",
    "astro-mermaid": "^2.0.2",
    "astro-pagefind": "^2.0.0",
    "mermaid": "^11.15.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "knip": "^6.16.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
